<mxCell id="cli" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;ConsumidorObserver&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0;margin-left:4px;"&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0;margin-left:4px;"&gt;&lt;u&gt;+ main(args : String[]) : void&lt;/u&gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="300" height="60" as="geometry"/></mxCell>
