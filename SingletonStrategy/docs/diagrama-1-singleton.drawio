<mxfile host="app.diagrams.net"><diagram name="d" id="docs/diagrama-1-singleton.drawio"><mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1260" pageHeight="540" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="cfg" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;i&gt;&amp;laquo;singleton&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;ConfiguracaoLoja&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0;margin-left:4px;"&gt;- pacPorKg : double {volatile}&lt;br&gt;- pacPorKm : double {volatile}&lt;br&gt;- sedexPorKg : double {volatile}&lt;br&gt;- sedexPorKm : double {volatile}&lt;br&gt;- sedexTaxaUrgencia : double {volatile}&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0;margin-left:4px;"&gt;- ConfiguracaoLoja()&lt;br&gt;&lt;u&gt;+ getInstance() : ConfiguracaoLoja&lt;/u&gt;&lt;br&gt;+ restaurarPadroes() : void&lt;br&gt;+ getPacPorKg() / setPacPorKg(valor)&lt;br&gt;+ getPacPorKm() / setPacPorKm(valor)&lt;br&gt;+ getSedexPorKg() / setSedexPorKg(valor)&lt;br&gt;+ getSedexPorKm() / setSedexPorKm(valor)&lt;br&gt;+ getSedexTaxaUrgencia() / setSedexTaxaUrgencia(valor)&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fillColor=#e1d5e7;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="400" height="330" as="geometry"/></mxCell>
<mxCell id="hold" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;i&gt;&amp;laquo;static nested&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;ConfiguracaoLoja.Holder&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0;margin-left:4px;"&gt;&lt;u&gt;- INSTANCE : ConfiguracaoLoja {final}&lt;/u&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0;margin-left:4px;"&gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fillColor=#e1d5e7;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="log" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;i&gt;&amp;laquo;singleton&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;AuditLog&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0;margin-left:4px;"&gt;&lt;u&gt;- instance : AuditLog {volatile}&lt;/u&gt;&lt;br&gt;- registros : List&amp;lt;String&amp;gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0;margin-left:4px;"&gt;- AuditLog()&lt;br&gt;&lt;u&gt;+ getInstance() : AuditLog&lt;/u&gt;&lt;br&gt;+ registrar(mensagem : String) : void {synchronized}&lt;br&gt;+ getRegistros() : List&amp;lt;String&amp;gt; {synchronized}&lt;br&gt;+ limpar() : void {synchronized}&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fillColor=#e1d5e7;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="560" y="20" width="360" height="200" as="geometry"/></mxCell>
<mxCell id="n1" value="&lt;b&gt;Técnica: initialization-on-demand holder&lt;/b&gt;&lt;br&gt;A classe Holder só é carregada no 1º getInstance(). A JVM garante que a inicialização de classe é thread-safe, então não precisa de synchronized." style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fffde7;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="450" y="330" width="280" height="150" as="geometry"/></mxCell>
<mxCell id="n2" value="&lt;b&gt;Técnica: double-checked locking + volatile&lt;/b&gt;&lt;br&gt;1ª verificação sem lock; se null, entra em synchronized(AuditLog.class) e verifica de novo antes de criar. O volatile impede ver o objeto meio construído.&lt;br&gt;registrar/getRegistros/limpar são synchronized; getRegistros() devolve List.copyOf (imutável)." style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fffde7;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="960" y="20" width="280" height="200" as="geometry"/></mxCell>
<mxCell id="e0" value="INSTANCE" style="html=1;rounded=0;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=12;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="hold" target="cfg"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="html=1;rounded=0;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="n1" target="cfg"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="html=1;rounded=0;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="n2" target="log"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>